managed implementation in class ZBP_R_TRAVEL217 unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZR_TRAVEL217 alias Travel
persistent table ztravel217
extensible
draft table ztravel_d217
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( global )
{
  field ( readonly )
  UUID,
  LocalCreatedBy,
  LocalCreatedAt,
  LocalLastChangedBy,
  LocalLastChangedAt,
  LastChangedAt;

  field ( numbering : managed )
  UUID;


  field ( recommendations ) Destination, Accommodation;
  recommendation function GetRecommendedValuesFunction;

  side effects
  {
    recommendation function GetRecommendedValuesFunction executed on field Description, field Destination;
  }


  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for ztravel217 corresponding extensible
    {
      UUID               = UUID;
      TravelID           = TRAVEL_ID;
      Description        = DESCRIPTION;
      Destination        = DESTINATION;
      Accommodation      = ACCOMMODATION;
      LocalCreatedBy     = LOCAL_CREATED_BY;
      LocalCreatedAt     = LOCAL_CREATED_AT;
      LocalLastChangedBy = LOCAL_LAST_CHANGED_BY;
      LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
      LastChangedAt      = LAST_CHANGED_AT;
    }

}